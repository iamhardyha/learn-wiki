# tools/privacy-check.sh 가 읽는 금칙어 목록의 예시 파일.
#
# 실제 목록은 레포 밖에 둔다 — 금칙어 자체가 비공개 정보이기 때문이다.
# 이 파일을 복사해서 채운 뒤 사용한다:
#
#   mkdir -p ~/.config/shelf
#   cp .privacy-patterns.example ~/.config/shelf/privacy-patterns.txt
#   # 편집기로 열어 실제 프로젝트 코드명·사내 도메인·업무 이메일을 넣는다
#
# 한 줄에 하나씩, 확장 정규식(ERE). '#'로 시작하는 줄과 빈 줄은 무시된다.
# 검사는 대소문자를 구분하지 않는다.
#
# ── 짧은 코드명에는 반드시 단어 경계 \b 를 붙일 것 ──
# 코드명이 4~5글자로 짧으면 흔한 영단어의 일부와 겹친다.
# 예를 들어 아래 example 패턴을 \b 없이 쓰면 "examples/" 디렉토리명까지 걸려
# 가드가 매번 실패하고, 결국 아무도 안 보게 된다.
# \b 를 붙이면 단어 전체가 일치할 때만 걸리고, 하이픈은 단어 경계로 취급되므로
# "<코드명>-pipeline" 같은 합성어는 그대로 잡힌다.

# 사내 프로젝트 코드명
\bmy-project-codename\b

# 회사·조직명
\bmy-company\b

# 업무 이메일 (아이디 부분만 적어도 충분)
first\.last@
